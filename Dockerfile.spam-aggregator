# syntax=docker/dockerfile:1.4
# Build stage
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git build-base

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies with cache mount
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code
COPY . .

# Build the Spam Aggregator binary with cache mounts
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o spam-aggregator cmd/spam-aggregator/main.go

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates bash

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/spam-aggregator .

# Copy ABI files if needed
COPY --from=builder /app/abi ./abi

ENTRYPOINT ["./spam-aggregator"]

