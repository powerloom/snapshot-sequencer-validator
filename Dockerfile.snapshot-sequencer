# syntax=docker/dockerfile:1.4
# Multi-stage Dockerfile for unified sequencer

# Build stage
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies with cache mount for faster rebuilds
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code
COPY . .

# Build unified binary with cache mounts for Go build cache
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -o bin/unified cmd/unified/main.go

# Runtime stage
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache ca-certificates

# Create non-root user
RUN addgroup -g 1000 sequencer && \
    adduser -D -u 1000 -G sequencer sequencer

WORKDIR /app

# Copy binaries from builder
COPY --from=builder /app/bin/unified /usr/local/bin/unified

# Copy ABI files
COPY --from=builder /app/abi /app/abi

# Make binaries executable and set proper ownership
RUN chmod +x /usr/local/bin/unified && \
    chown -R sequencer:sequencer /app/abi

# Switch to non-root user
USER sequencer

# Default to unified binary
ENTRYPOINT ["/usr/local/bin/unified"]